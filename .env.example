# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the resulting .env file.

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=postgres
# Required — the api service refuses to start without this set.
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=downloadcache

# ============================================================
# Backend / API
# ============================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# JWT signing secret for access/refresh tokens. Generate a real one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The admin account created automatically on first startup (only if the
# users table is empty — safe to leave these set permanently).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-to-a-strong-password

# Origins allowed to make credentialed cross-origin requests to the API.
# JSON array. Only matters for direct browser access to the API port
# (e.g. testing against /docs) — the dashboard itself talks same-origin
# via its rewrite proxy and isn't affected by this.
CORS_ORIGINS=["http://localhost:3000"]

# Cookie flags for the JWT/session cookies the API sets on login.
# COOKIE_SECURE=true requires the API to be served over HTTPS (i.e. behind
# a TLS-terminating reverse proxy) — set to false only for plain-HTTP local
# development.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Rate limits (slowapi syntax, e.g. "5/minute", "120/minute").
LOGIN_RATE_LIMIT=5/minute
DEFAULT_RATE_LIMIT=120/minute

# ============================================================
# qBittorrent
# ============================================================
# In docker-compose these point at the qbittorrent service by name — only
# change QBITTORRENT_USERNAME/PASSWORD to match what you've set in
# qBittorrent's own WebUI (Tools > Options > Web UI), which defaults to a
# random temporary password printed in `docker compose logs qbittorrent`
# the first time it starts. Set a fixed one there before relying on this.
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me-to-match-qbittorrent-webui-password
QBITTORRENT_USE_HTTPS=false
# Tag applied to every torrent this platform adds, so it can tell its own
# jobs apart from anything else in the same qBittorrent instance.
QBITTORRENT_TAG=dlcache

# How often (seconds) the backend polls qBittorrent for job status.
POLL_INTERVAL_SECONDS=2

# ============================================================
# Storage & Cache
# ============================================================
# Path inside the api/qbittorrent containers where downloads and cached
# files live — both containers mount the same `downloads_data` volume here,
# so leave this as /data unless you also change the docker-compose.yml mounts.
STORAGE_ROOT=/data

# Hard cap on total storage the cache manager will let itself use before
# eviction becomes aggressive regardless of file age.
MAX_STORAGE_GB=500

# Eviction kicks in once usage crosses this fraction of MAX_STORAGE_GB
# (0.85 = start evicting once 85% full), evicting least-recently-used files
# first until usage drops back under the threshold.
CACHE_EVICTION_THRESHOLD=0.85

# Files younger than this are protected from eviction unless MAX_STORAGE_GB
# itself is exceeded (i.e. retention is a soft preference, the hard cap wins).
CACHE_RETENTION_DAYS=30

# How often (seconds) the eviction policy runs.
EVICTION_INTERVAL_SECONDS=300

# Chunk size (bytes) used when streaming files to clients.
STREAM_CHUNK_SIZE_BYTES=1048576

# ============================================================
# Dashboard
# ============================================================
# Host port the dashboard is published on.
DASHBOARD_PORT=3000
# Host port the API is published on (for API-key-authenticated clients —
# see docker-compose.yml).
API_PORT=8000

# ============================================================
# qBittorrent container (linuxserver/qbittorrent image) file ownership
# ============================================================
PUID=1000
PGID=1000
TZ=Etc/UTC
